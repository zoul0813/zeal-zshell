#ifndef VERSION_H
#define VERSION_H

#include "config.h"

#define APP_NAME "@APP_NAME@"
#define APP_VERSION_MAJOR @APP_VERSION_MAJOR@
#define APP_VERSION_MINOR @APP_VERSION_MINOR@
#define APP_VERSION_PATCH @APP_VERSION_PATCH@
#if CONFIG_DEV_BUILD_NUMBER
#define APP_VERSION_BUILD @BUILD_NUMBER@
#endif
#define APP_VERSION_STRING "@APP_VERSION_MAJOR@.@APP_VERSION_MINOR@.@APP_VERSION_PATCH@"

#endif /* VERSION_H */
